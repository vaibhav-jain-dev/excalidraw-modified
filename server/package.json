{
  "name": "excalidraw-local-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first storage, rendering, search and MCP server for Excalidraw (see ../LOCAL_FIRST_PLAN.md)",
  "main": "src/index.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "mcp": "node src/mcp/stdio.ts",
    "test": "node --test 'src/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "fastify": "5.12.3",
    "puppeteer-core": "24.0.0",
    "sqlite-vec": "0.1.9"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "typescript": "5.9.3"
  }
}
